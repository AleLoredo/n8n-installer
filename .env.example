# n8n Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
NODE_ENV=production

# Owner Account Credentials (created automatically on first launch)
N8N_OWNER_EMAIL=admin@example.com
N8N_OWNER_PASSWORD=
N8N_OWNER_FIRST_NAME=Admin
N8N_OWNER_LAST_NAME=User

