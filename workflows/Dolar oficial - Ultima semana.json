        "jsCode": "const hoy = $now.setZone('America/Argentina/Buenos_Aires').startOf('day');\nconst desde = hoy.minus({ days: 7 }).toISODate();\nconst hasta = hoy.toISODate();\nconst datos = $input.all().flatMap(item => Array.isArray(item.json) ? item.json : [item.json]);\nconst filas = datos\n  .filter(d => d.fecha >= desde && d.fecha < hasta && d.casa === 'oficial')\n  .sort((a, b) => a.fecha.localeCompare(b.fecha))\n  .map(d => ({ json: { fecha: d.fecha, compra: d.compra, venta: d.venta, moneda: 'ARS por USD' } }));\nif (!filas.length) throw new Error('La fuente no devolvio cotizaciones para los ultimos 7 dias completos.');\nreturn filas;"
      },
